# Copiar a .env y completar. Nunca subir el .env real.
# Acá van solo los secretos. Lo demás (IDs, servidor de avisos, host y puerto de Lavalink, canal del plugin
# de YouTube) va en config/config.yml: copiar config/config.example.yml.

# Token del bot (Developer Portal → tu app → Bot → Reset Token)
token=""

# Contraseña de Lavalink: igual a server.password de application.yml
lavalinkPassword="cambiar-esta-contraseña"

# Contraseña de yt-cipher (servidor de descifrado de YouTube).
# Igual a plugins.youtube.remoteCipher.password de application.yml
YT_CIPHER_TOKEN="cambiar-este-token"

# Base de datos (favoritos, playlists y volumen por servidor).
# Vacío = archivo SQLite en data/bot.db, sin configurar nada.
# Para compartir los datos entre varias PCs que corren el bot, la URL de un Postgres (por ejemplo Supabase:
# Connect → Session pooler). Es una contraseña: nunca la subas ni la compartas.
DATABASE_URL=""
